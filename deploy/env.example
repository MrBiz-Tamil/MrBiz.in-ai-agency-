# Copy to deploy/.env (git-ignored) and fill in. Generate secrets with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Infra (used by docker-compose.yml) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Go backend (backend-core) ---
ABOS_ENV=production            # "dev" enables playground, introspection, simulated tool execution
ABOS_HTTP_ADDR=127.0.0.1:8080
ABOS_GRPC_ADDR=127.0.0.1:50052
DATABASE_URL=postgres://abos:CHANGE_ME@127.0.0.1:5432/abos?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
ABOS_ALLOWED_ORIGINS=http://127.0.0.1:3000   # websocket/CORS origins
ABOS_DB_ROLE=abos_app          # non-superuser role set on every connection so row-level security applies
ABOS_AUTO_MIGRATE=0            # 1 = apply pending migrations at startup (dev default). Otherwise: abosadmin migrate up
ABOS_VAULT_KEY=                # base64 of 32 random bytes; encrypts MCP credentials. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ABOS_AGENT_DAILY_LIMIT_USD=10

# Shopify webhook (route is disabled when the secret is empty)
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WORKSPACE_ID=          # UUID of the workspace this shop belongs to

# --- Shared by Go and Python for service-to-service auth ---
ABOS_INTERNAL_SECRET=          # >= 32 chars
# Optional mutual TLS for gRPC (PEM files)
ABOS_TLS_CERT=
ABOS_TLS_KEY=
ABOS_TLS_CA=

# --- Python AI service (ai-service) ---
ABOS_AI_ADDR=127.0.0.1:50051   # used by the Go client
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ABOS_ALLOW_MOCK_LLM=1        # dev only; never set in production

# --- Frontend ---
# Server-side only (never sent to the browser): where the SvelteKit server reaches the Go backend
ABOS_BACKEND_URL=http://127.0.0.1:8080
PUBLIC_GRAPHQL_WS_URL=ws://127.0.0.1:8080/graphql
