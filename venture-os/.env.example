# Venture OS environment. Do not edit by hand: run scripts/gen-env.ps1 (Windows) or scripts/gen-env.sh,
# which copies this file to .env and fills every CHANGE_ME with a generated URL-safe secret.
# All generated secrets are hex, because several of them are embedded in connection URLs.

# ── Routing ────────────────────────────────────────────────────────────────
# Local: BASE_DOMAIN=localhost, SCHEME=http  → app.localhost, auth.localhost, …  (*.localhost resolves to loopback)
# Production: your real domain, SCHEME=https (Caddy obtains certificates; DNS for every host below must exist).
BASE_DOMAIN=localhost
SCHEME=http
HTTP_PORT=80
HTTPS_PORT=443
VENTURE_ENV=production
VENTURE_VERSION=dev
# Which external systems the control plane really provisions. VENTURE_CONNECTORS is the default for all of them;
# VENTURE_CONNECTOR_<SYSTEM> overrides one. Real adapters exist for IDENTITY (Keycloak), ERP (ERPNext), RUNTIME
# (Hermes) and CRM (Venture OS's built-in CRM). SUPPORT (LibreDesk) has no adapter yet, so it must be "fake".
# "fake" creates nothing real. To go (partly) real, e.g.:
#   VENTURE_CONNECTORS=real
#   VENTURE_CONNECTOR_CRM=fake
#   VENTURE_CONNECTOR_SUPPORT=fake
# and fill the credentials below (ERP_API_KEY/ERP_API_SECRET are created in ERPNext after first boot).
VENTURE_CONNECTORS=fake
VENTURE_CONNECTOR_IDENTITY=
VENTURE_CONNECTOR_ERP=
VENTURE_CONNECTOR_CRM=
VENTURE_CONNECTOR_SUPPORT=
VENTURE_CONNECTOR_RUNTIME=
# Integrations (Google Calendar/Meet, Zoom, Notion). The master key seals every connected account's credentials before
# they are stored; without it integrations are switched off. Format 1:<base64 of 32 random bytes>. gen-env creates one.
# KEEP A COPY: if it is lost, connected accounts must be reconnected. To rotate: append ,2:<new> and set CURRENT=2.
VENTURE_SECRETS_KEYS=CHANGE_ME_B64KEY
VENTURE_SECRETS_CURRENT=
# Offer the meetings and notes tools to agents (needs the key above).
VENTURE_COLLAB_TOOLS=true
# Outside dev, running with any fake system requires this explicit consent. Set false once everything is real.
VENTURE_ALLOW_FAKE_CONNECTORS=true

# ── Postgres roles (see infra/postgres/init/01-bootstrap.sh) ───────────────
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
VENTURE_OWNER_PASSWORD=CHANGE_ME
VENTURE_APP_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
TWENTY_DB_PASSWORD=CHANGE_ME
LIBREDESK_DB_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Keycloak ───────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_SERVICE_CLIENT_SECRET=CHANGE_ME
# First founder account imported with the realm. The password is temporary: Keycloak forces a change at login.
FOUNDER_EMAIL=founder@example.com
FOUNDER_INITIAL_PASSWORD=CHANGE_ME

# ── Twenty CRM ─────────────────────────────────────────────────────────────
TWENTY_APP_SECRET=CHANGE_ME
TWENTY_ENCRYPTION_KEY=CHANGE_ME
# Created in Twenty after first boot (Settings → APIs). Required by the provisioner.
TWENTY_API_KEY=

# ── LibreDesk ──────────────────────────────────────────────────────────────
LIBREDESK_SYSTEM_USER_PASSWORD=CHANGE_ME
# Must be exactly 32 characters (generated with openssl rand -hex 16).
LIBREDESK_ENCRYPTION_KEY=CHANGE_ME_32
# Created in LibreDesk after first boot (Admin → Users → API key). Required by the provisioner.
LIBREDESK_API_KEY=
LIBREDESK_API_SECRET=

# ── ERPNext ────────────────────────────────────────────────────────────────
ERP_DB_ROOT_PASSWORD=CHANGE_ME
ERP_ADMIN_PASSWORD=CHANGE_ME
# Must resolve to Caddy, so keep it equal to erp.<BASE_DOMAIN>.
ERP_SITE_NAME=erp.localhost
# Created in ERPNext after first boot (User → API Access → Generate Keys). Required by the provisioner.
ERP_API_KEY=
ERP_API_SECRET=

# ── Hermes ─────────────────────────────────────────────────────────────────
HERMES_API_SERVER_KEY=CHANGE_ME
# Bootstrap bearer token for Hermes → MCP bus. Per-tenant tokens are minted by the control plane.
HERMES_MCP_TOKEN=
# Must equal the controlplane image's uid (10001): the control plane writes Hermes profiles into the shared volume.
HERMES_UID=10001
HERMES_GID=10001

# ── Venture OS services ────────────────────────────────────────────────────
MCP_TOKEN_SIGNING_KEY=CHANGE_ME
# Encrypts the Command Center's session cookie (>= 32 chars; generated). Rotating it signs everyone out.
WEB_SESSION_SECRET=CHANGE_ME
GENESIS_MODEL=claude-sonnet-5-5

# ── LLM providers (at least one is required for agents and the Genesis interview) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Image / source pins ────────────────────────────────────────────────────
POSTGRES_TAG=pg17
REDIS_TAG=7.4-alpine
MARIADB_TAG=11.8
KEYCLOAK_TAG=26.8.2
TWENTY_TAG=v2.62.0
LIBREDESK_TAG=v2.9.2
ERPNEXT_TAG=v16.60.0
CADDY_TAG=2.10-alpine
# Built from source (git tags). Pin to a commit SHA for reproducible production builds.
HERMES_REF=v0.23.3
