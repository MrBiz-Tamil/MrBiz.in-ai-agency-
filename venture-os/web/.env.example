# Command Center configuration (read at runtime by the Node server; nothing here is exposed to the browser).
# In Docker these are set by docker-compose.yml. For local work without Docker/Keycloak use scripts/dev.ps1.

# oidc (default) = sign in through Keycloak. dev = authentication bypass for local demos; REFUSED when NODE_ENV=production.
AUTH_MODE=oidc

# Where the Node server reaches the control plane (server to server).
CONTROLPLANE_URL=http://controlplane:8080

# The public URL users browse to. Must match a redirect URI allowed on the Keycloak "venture-web" client.
ORIGIN=http://app.localhost

OIDC_ISSUER_URL=http://auth.localhost/realms/venture
OIDC_CLIENT_ID=venture-web

# Encrypts the session cookie. At least 32 characters; generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to "fake" when the control plane simulates provisioning: the UI then shows a banner saying so.
VENTURE_CONNECTORS=fake
